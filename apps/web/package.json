{
  "name": "@wrk/web",
  "version": "0.1.0",
  "private": true,
  "description": "Protocol-level read-only UI over the WRK API: landing, docs, monitoring and inspection.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "pnpm --filter @wrk/api build && next build && node verify/build.mjs",
    "start": "next start -p 3100",
    "verify:views": "node verify/views.mjs",
    "verify:live-data": "node verify/live-data.mjs",
    "verify:network-selector": "node verify/network-selector.mjs",
    "verify:settlement-view": "node verify/settlement-view.mjs",
    "verify:provenance": "node verify/provenance.mjs",
    "verify:landing": "node verify/landing.mjs",
    "verify:docs-page": "node verify/docs-page.mjs",
    "verify:monitoring": "node verify/monitoring.mjs",
    "verify:pages": "node verify/pages.mjs",
    "verify:all": "pnpm verify:views && pnpm verify:live-data && pnpm verify:network-selector && pnpm verify:settlement-view && pnpm verify:provenance && pnpm verify:landing && pnpm verify:docs-page && pnpm verify:monitoring && pnpm verify:pages",
    "test": "vitest run --reporter=dot --reporter=json --outputFile=.vitest-result.json && node verify/tests.mjs"
  },
  "dependencies": {
    "@wrk/api": "workspace:*",
    "next": "16.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@wrk/indexer": "workspace:*",
    "@wrk/types": "workspace:*",
    "mongodb": "6.21.0",
    "mongodb-memory-server": "10.4.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
