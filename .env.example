# WRK DAO — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not.
# Nothing here is read by the settlement path except the RPC URL and the
# attestor keys: the adapter takes mandate, amount and payee from chain state,
# never from configuration. See docs/ARCHITECTURE.md invariant I10.

# ─────────────────────────────────────────────────────────────── GenLayer
# Studionet RPC. The account must be funded before deployment.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_PRIVATE_KEY=
# Populated by deploy/ after a successful deployment.
GENLAYER_REGISTRY_ADDRESS=
GENLAYER_WORK_ADDRESS=
GENLAYER_ADJUDICATOR_ADDRESS=
GENLAYER_REPUTATION_ADDRESS=

# ─────────────────────────────────────────────────────────────── Base
BASE_SEPOLIA_RPC_URL=
BASE_CHAIN_ID=84532
BASE_DEPLOYER_KEY=
# Circle's USDC on Base Sepolia. Verify before use; do not trust this comment.
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_ESCROW_ADDRESS=
BASE_VERIFIER_ADDRESS=

# ─────────────────────────────────────────────────── Settlement attestors
# M-of-N. Each key signs the EIP-712 Settlement struct (docs/ARCHITECTURE.md §8).
# Distinct keys: N attestors sharing one key is a 1-of-1 wearing an M-of-N badge.
SETTLEMENT_ATTESTOR_KEY_1=
SETTLEMENT_ATTESTOR_KEY_2=
SETTLEMENT_ATTESTOR_KEY_3=
SETTLEMENT_THRESHOLD=2

# Seconds between `post` and the earliest legal `execute`. 3600 per the owner's
# decision. The contract enforces it; this value only tells the keeper when to
# bother trying.
SETTLEMENT_CHALLENGE_WINDOW_SECONDS=3600

# ─────────────────────────────────────────────────────── Read model (Mongo)
# Read model only. Losing this database costs an indexer rebuild, never funds.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wrk

# ─────────────────────────────────────────────────────────────── Services
API_PORT=8787
API_BASE_URL=http://127.0.0.1:8787
INDEXER_POLL_INTERVAL_MS=4000
LOG_LEVEL=info
